#include <windows.h>

// ---------------------------------------------------------------------------
// 1. Application Icon (optional: place icon.ico in your project folder)
// ---------------------------------------------------------------------------
// 1 ICON "icon.ico"

// ---------------------------------------------------------------------------
// 2. Version Information (Details Tab in File Properties)
// ---------------------------------------------------------------------------
1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // U.S. English (0409), Unicode/UTF-16 (04B0)
        BEGIN
            VALUE "CompanyName",      "JetmyV2"
            VALUE "FileDescription",  "JetmyV2"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "JetmyV2"
            VALUE "OriginalFilename", "JetmyV2.exe"
            VALUE "ProductName",      "JetmyV2"
            VALUE "ProductVersion",   "2.0.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 JetmyV2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

// ---------------------------------------------------------------------------
// 3. Embedded Application Manifest (DPI Awareness & Modern Visual Styles)
// ---------------------------------------------------------------------------
1 24
BEGIN
"<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>"
"<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">"
"  <assemblyIdentity version=""2.0.0.0"" processorArchitecture=""*"" name=""JetmyV2"" type=""win32""/>"
"  <trustInfo xmlns=""urn:schemas-microsoft-com:asm.v3"">"
"    <security>"
"      <requestedPrivileges>"
"        <requestedExecutionLevel level=""asInvoker"" uiAccess=""false""/>"
"      </requestedPrivileges>"
"    </security>"
"  </trustInfo>"
"  <application xmlns=""urn:schemas-microsoft-com:asm.v3"">"
"    <windowsSettings>"
"      <!-- Prevents Windows from blurring GDI rendering on 125%%/150%% scaling -->"
"      <dpiAware xmlns=""http://schemas.microsoft.com/SMI/2005/WindowsSettings"">true/pm</dpiAware>"
"      <dpiAwareness xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">PerMonitorV2, PerMonitor</dpiAwareness>"
"    </windowsSettings>"
"  </application>"
"  <dependency>"
"    <dependentAssembly>"
"      <assemblyIdentity type=""win32"" name=""Microsoft.Windows.Common-Controls"" version=""6.0.0.0"" processorArchitecture=""*"" publicKeyToken=""6595b64144ccf1df"" language=""*""/>"
"    </dependentAssembly>"
"  </dependency>"
"</assembly>"
END